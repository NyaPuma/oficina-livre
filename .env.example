# Base de dados PostgreSQL (usar docker compose up -d)
DATABASE_URL=postgres://oficina:oficina@localhost:5432/oficina_livre

# Segredo para assinar os cookies de sessão (gerar com: openssl rand -base64 32)
SESSION_SECRET=substituir-por-um-segredo-aleatorio-longo

# Configuração inicial (usada por npm run db:seed)
SEED_ADMIN_EMAIL=admin@oficinalivre.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrador

# Email opcional (PDFs e notificações). Se omitido, o envio é ignorado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Oficina Livre <nao-responder@oficinalivre.local>

# NIF da oficina (usado na exportação SAF-T)
COMPANY_NIF=000000000

# URL pública da aplicação (para links em emails e diagnósticos)
APP_URL=http://localhost:3000

# API pública v1: chave obrigatória para /api/v1/* (gerar com openssl rand -hex 24)
API_KEY=

# Consulta opcional de matrículas/VIN (deixar vazio para validação local sem custo)
VEHICLE_LOOKUP_URL=
VEHICLE_LOOKUP_TOKEN=

# TecDoc / TecRMI — serviço comercial, requer licença e credenciais próprias.
# O endpoint deve expor POST /parts/search e POST /vehicles/identify.
# Sem estas variáveis a aplicação usa um catálogo LOCAL DE DEMONSTRAÇÃO.
TECDOC_API_URL=
TECDOC_API_KEY=
TECDOC_DATA_SUPPLIER=

# --- Gateway de pagamentos -------------------------------------------------
# PAYMENT_PROVIDER=none | stripe | sibs. Sem credenciais, fica em modo demonstração.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SIBS_API_URL=
SIBS_API_KEY=
SIBS_WEBHOOK_SECRET=

# --- Assinatura eletrónica qualificada --------------------------------------
# Serviço externo com certificado qualificado (ex.: QSign/DocuSign/ ClickSign).
QSIGN_API_URL=
QSIGN_API_KEY=
QSIGN_WEBHOOK_SECRET=

# --- SAF-T certificado pela AT ----------------------------------------------
# Só preencher quando a aplicação tiver certificado de software atribuído pela AT.
AT_COMPANY_NIF=
AT_SOFTWARE_CERTIFICATE_NUMBER=
AT_PRODUCT_ID=Oficina Livre
AT_PRODUCT_VERSION=0.4.0
AT_VENDOR_NIF=
